{
  "name": "newcastle-automotive-solutions",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newcastle-automotive-solutions-db",
      "database_id": "159b2c5e-f4e0-431b-92ab-4d10c8e488b3"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "newcastle-automotive-solutions-photos" }
  ],
  "vars":"services": [
  { "binding": "XERO_WORKER", "service": "nas-xero-connector" }
] {
    "XERO_WORKER_URL": "https://nas-xero-connector.nas-newcastle.workers.dev"
  }
}
